---
// The landing page's hero: the promise on the left, WaGo at work on the right.
import { LinkButton } from '@astrojs/starlight/components';
import ChatDemo from './ChatDemo.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<section class="wg-hero">
  <div class="wg-copy">
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="wg-tagline" set:html={tagline} />}
    <div class="wg-actions">
      {actions.map(({ link: href, text, variant, icon }) => (
        <LinkButton {href} {variant} icon={icon?.name}>{text}</LinkButton>
      ))}
    </div>
  </div>
  <ChatDemo />
</section>

<style>
  .wg-hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: clamp(1.5rem, 5vw, 4.5rem) clamp(1rem, 3vw, 2.5rem);
  }
  @media (min-width: 60rem) {
    .wg-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 27rem); gap: clamp(2.5rem, 5vw, 5rem); }
  }
  .wg-copy { display: grid; gap: 1.25rem; min-width: 0; }
  h1 {
    margin: 0;
    font: 700 clamp(2.4rem, 1.4rem + 3.6vw, 4rem)/1.04 var(--wg-display);
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .wg-tagline {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(1.02rem, 0.95rem + 0.35vw, 1.18rem);
    line-height: 1.6;
    color: var(--sl-color-gray-3);
  }
  .wg-tagline :global(b) { display: block; margin-bottom: 0.35rem; font-weight: 600; color: var(--sl-color-white); }
  .wg-actions { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; align-items: center; margin-top: 0.25rem; }
</style>
